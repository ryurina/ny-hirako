# Copier ce fichier en .env puis adapter les valeurs
PORT=3000

# Ajouter utilisateur:motdepasse@ devant localhost si votre PostgreSQL l'exige
DATABASE_URL=postgresql://localhost:5432/nyhirako

# Chaîne secrète longue et aléatoire, par exemple : openssl rand -hex 32
JWT_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=8h

# Adresse du frontend Vite (plusieurs origines possibles, séparées par des virgules)
CORS_ORIGIN=http://localhost:5173

# --- Base de données hébergée (facultatif ; voir docs/DEPLOIEMENT.md) ---
# Ajouter ?sslmode=require à DATABASE_URL si l'hébergeur impose le chiffrement.
# Pour vérifier le certificat du serveur, coller ici le certificat CA (contenu du fichier .pem) :
# DATABASE_CA=
# Nombre maximal de connexions du pool (3 conseillé sur Vercel avec une limite de 15 connexions) :
# DATABASE_POOL_MAX=10
