# Copier ce fichier en .env puis adapter les valeurs
PORT=3000

# Ajouter utilisateur:motdepasse@ devant localhost si votre PostgreSQL l'exige
DATABASE_URL=postgresql://localhost:5432/nyhirako

# Chaîne secrète longue et aléatoire, par exemple : openssl rand -hex 32
JWT_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=8h

# Adresse du frontend Vite (plusieurs origines possibles, séparées par des virgules)
CORS_ORIGIN=http://localhost:5173
